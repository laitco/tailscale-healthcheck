# Copy this file to .env and fill in secrets for local development.
#
# IMPORTANT: every setting below is now DB-backed with env-override semantics
# (see dbstore.py's SETTINGS_REGISTRY). Whenever an env var here IS set, it
# always wins and is synced into the SQLite database (DATABASE_PATH) on every
# boot; removing the env var later falls back to whatever was last synced or
# saved via the admin UI (/admin/settings), NOT back to the hardcoded default.
# All of these are also editable at runtime via /admin/settings, except where
# noted below - env vars you leave unset here can be configured entirely
# through the web UI (starting with the first-run wizard at /admin/setup).

# Authentication (choose one: OAuth preferred). These are optional now - if
# left unset, the app serves a first-run setup wizard at /admin/setup where
# they can be entered and saved to the SQLite database instead.
# AUTH_TOKEN=your-tailscale-api-token
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Tailnet and server settings
TAILNET_DOMAIN=example.com
# PORT and the Gunicorn bind/worker flags (see Dockerfile ENTRYPOINT) are
# process-bootstrap concerns, not runtime app config - they are NOT part of
# the settings registry and are not editable via /admin/settings.
PORT=5000
TIMEZONE=UTC
HTTP_TIMEOUT=10

# Public base URL for this instance (e.g. behind a reverse proxy with a
# different external hostname). Used for example curl commands and "Try it"
# calls on the built-in API docs page (/admin/api-docs). Leave blank to use
# the current page's origin.
# API_BASE_URL=https://healthcheck.example.com

# Where the SQLite database (settings, users, device/key snapshots, audit
# log, metrics history) is stored. Defaults to /data/healthcheck.db in Docker
# (mount a volume at /data to persist it) or a temp directory for local dev.
# DATABASE_PATH=/data/healthcheck.db

# Signs admin session cookies. Optional - if unset, a random key is
# generated on first boot and persisted to the database so all Gunicorn
# workers share it. Set explicitly if you want sessions to survive a full
# database wipe/migration.
# SECRET_KEY=

# How often (seconds) the background poller refreshes devices/tailnet keys
# from the Tailscale API into SQLite. /health*, /keys, and the dashboard all
# read from that snapshot rather than calling the Tailscale API per request.
POLL_INTERVAL_SECONDS=60

# How long (days) audit log entries (device/key/setting/user changes) are
# kept before being purged. Also editable via the /admin/settings UI.
AUDIT_RETENTION_DAYS=14

# How long (days) the poller's operational activity log (poller_log table,
# shown on /debug) is kept before being purged. Separate from
# AUDIT_RETENTION_DAYS since this is high-volume operational noise, not the
# compliance-flavored audit trail. Also editable via /admin/settings.
POLLER_LOG_RETENTION_DAYS=7

# Optional: lock the public, unauthenticated /health endpoint behind a
# shared-secret header (X-Health-Token). Leave unset/empty to keep /health
# fully open (the default - existing Gatus/monitoring configs keep working
# unchanged). Also editable via /admin/settings.
# HEALTH_ENDPOINT_TOKEN=

# Rate limiting (per-minute). NOTE: changes to any RATE_LIMIT_* setting via
# /admin/settings are persisted immediately but only take effect after a
# process restart - Flask-Limiter is wired up once at app startup.
RATE_LIMIT_ENABLED=YES
# Integer only; requests per minute per IP (0 disables). Default 100.
RATE_LIMIT_PER_IP=100
# Optional global per-minute integer limit across all clients/endpoints (0/empty disables)
RATE_LIMIT_GLOBAL=
# Optional storage backend (default is file:///tmp/tailscale-healthcheck-ratelimit.json)
# - Redis:  redis://host:6379/0
# - File:   file:///path/to/ratelimit.json (shared on host)
# - Empty:  in-memory (per-process)
# RATE_LIMIT_STORAGE_URL=
# Include standard rate limit headers when Flask-Limiter is active
RATE_LIMIT_HEADERS_ENABLED=YES

# Retry/backoff controls for outbound requests (resolved fresh on every
# outbound call, so /admin/settings changes apply without a restart)
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.5
BACKOFF_MAX_SECONDS=8.0
BACKOFF_JITTER_SECONDS=0.1

# Logging. NOTE: LOG_LEVEL changes via /admin/settings are persisted but only
# take effect after a process restart (logging.basicConfig runs once at
# import). DEBUG_LOG_ENABLED controls whether the background poller records
# into its in-memory ring buffer (surfaced on the /debug page) - this one DOES
# apply immediately, no restart needed.
LOG_LEVEL=INFO
DEBUG_LOG_ENABLED=YES

# Health thresholds and behavior
ONLINE_THRESHOLD_MINUTES=5
KEY_THRESHOLD_MINUTES=1440
# Tailnet API/auth key expiry warning threshold, in days
KEY_EXPIRY_WARNING_DAYS=30
GLOBAL_HEALTHY_THRESHOLD=100
GLOBAL_ONLINE_HEALTHY_THRESHOLD=100
GLOBAL_KEY_HEALTHY_THRESHOLD=100
GLOBAL_UPDATE_HEALTHY_THRESHOLD=100
UPDATE_HEALTHY_IS_INCLUDED_IN_HEALTH=NO

# Device filters (comma-separated; wildcards allowed)
INCLUDE_OS=
EXCLUDE_OS=
INCLUDE_IDENTIFIER=
EXCLUDE_IDENTIFIER=
INCLUDE_TAGS=
EXCLUDE_TAGS=
INCLUDE_IDENTIFIER_UPDATE_HEALTHY=
EXCLUDE_IDENTIFIER_UPDATE_HEALTHY=
INCLUDE_TAG_UPDATE_HEALTHY=
EXCLUDE_TAG_UPDATE_HEALTHY=

# Tailnet API/auth key filters (comma-separated; wildcards allowed).
# INCLUDE_KEY_TYPE/EXCLUDE_KEY_TYPE match against the inferred key type
# ("api" or "auth"); INCLUDE_KEY_DESCRIPTION/EXCLUDE_KEY_DESCRIPTION match
# against the key's description field. INCLUDE takes precedence over EXCLUDE,
# same convention as the device filters above.
INCLUDE_KEY_TYPE=
EXCLUDE_KEY_TYPE=
INCLUDE_KEY_DESCRIPTION=
EXCLUDE_KEY_DESCRIPTION=

# Gunicorn settings (process bootstrap, not part of the settings registry)
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=120

# Internal flag used by Gunicorn master init (do not set manually in prod)
# GUNICORN_MASTER_PROCESS=true
